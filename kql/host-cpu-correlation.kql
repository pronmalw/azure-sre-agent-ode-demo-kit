// Host CPU vs latency correlation
// Contoso Retail — Azure SRE Agent Demo
// Usage: run against the Log Analytics workspace (law-*), NOT the App Insights
// classic schema. Container CPU only exists in the workspace, so both halves of
// the correlation are kept workspace-side.
//
// Note: cpuUsageNanoCores is emitted by Container Insights into Perf under
// ObjectName 'K8SContainer'. It is NOT in InsightsMetrics.

let cpu =
    Perf
    | where ObjectName == 'K8SContainer' and CounterName == 'cpuUsageNanoCores'
    | summarize avgCpuCores = avg(CounterValue) / 1000000000.0
        by bin(TimeGenerated, 1m), Computer;
let latency =
    AppRequests
    | summarize p99 = percentile(DurationMs, 99)
        by bin(TimeGenerated, 1m);
cpu
| join kind=leftouter latency on TimeGenerated
| project TimeGenerated, Computer, avgCpuCores, p99
| order by TimeGenerated desc
