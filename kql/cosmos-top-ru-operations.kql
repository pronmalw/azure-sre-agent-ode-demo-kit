// Top RU consuming operations
// Contoso Retail — Azure SRE Agent Demo
// Usage: Paste into Log Analytics or Application Insights Logs

dependencies
| where target has 'documents.azure.com'
| extend ru = todouble(customDimensions['ruCharge'])
| summarize totalRu=sum(ru), avgDuration=avg(duration) by name
| top 10 by totalRu desc
